# Server
PORT=5000
NODE_ENV=development

# Public base URL of THIS backend (used to build absolute image URLs).
# In production, set this to your deployed backend URL, e.g. https://api.visiontag.com
BASE_URL=http://localhost:5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/visiontag

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Azure Cognitive Services — Computer Vision
# Get these from Azure Portal -> your Computer Vision resource -> Keys and Endpoint
AZURE_VISION_KEY=your_azure_computer_vision_key
AZURE_VISION_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com

# Max time (ms) to wait for Azure before returning a timeout error
AZURE_TIMEOUT_MS=15000

# Upload limits
MAX_UPLOAD_MB=10

# Email (for forgot-password) — any SMTP provider works (Gmail, SendGrid, Mailtrap, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="VisionTag <no-reply@visiontag.com>"

# Password reset link — where the frontend's ResetPassword page lives
RESET_PASSWORD_URL=http://localhost:5173/reset-password
